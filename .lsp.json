{
  "csharp": {
    "command": "dotnet",
    "args": ["tool", "run", "csharp-ls", "--", "--solution", "IAW.slnx"],
    "extensionToLanguage": {
      ".cs": "csharp"
    },
    "restartOnCrash": true,
    "maxRestarts": 3
  },
  "typescript": {
    "command": "npx",
    "args": ["--prefix", "website", "typescript-language-server", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact"
    },
    "workspaceFolder": "website",
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
